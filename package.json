{
    "name": "vscodium-plugins-trans",
    "displayName": "VSCodium 扩展汉化",
    "description": "使用 package.nls.zh-cn.json 汉化受支持的扩展。",
    "version": "1.0.0",
    "publisher": "GeoKung",
    "engines": {
        "vscode": "^1.105.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./out/extension.js",
    "activationEvents": [ "onStartupFinished" ],
    "repository": {
        "url": "https://github.com/576419113/VSCodium-Plugins-Trans",
        "type": "git"
    },
    "contributes": {
        "commands": [
            {
                "command": "vscodium-trans.nls-export",
                "title": "将所有扩展的 package.nls.json 导出"
            },
            {
                "command": "vscodium-trans.nls-import",
                "title": "使用内置 package.nls.zh-cn.json 导入"
            }
        ],
        "configuration":[
            {
                "title": "VSCodium 扩展汉化",
                "properties": {
                    "vscodium-trans.vscodium-plugins-path": {
                        "type": "string",
                        "description": "VSCodium 扩展存储位置"
                    }
                }
            }
        ]
    },
    "scripts": {
        "compile": "tsc -p ./"
    },
    "devDependencies": {
        "@types/node": "^22.20.2",
        "@types/vscode": "1.105.0",
        "typescript": "^7.0.2"
    }
}
